# ==============================================================================
# SECOND BRAIN - ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Copy this file or the respective client/.env.example and server/.env.example
# to .env files before running the application. Never commit actual secrets to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND VARIABLES (client/.env)
# Exposed to Vite client with VITE_ prefix. DO NOT put private server secrets here.
# ------------------------------------------------------------------------------

# Auth0 Domain from your Auth0 Application Settings (e.g., dev-xyz.us.auth0.com)
VITE_AUTH0_DOMAIN=

# Auth0 Client ID from your Single Page Application in Auth0 Dashboard
VITE_AUTH0_CLIENT_ID=

# Auth0 API Audience identifier configured in Auth0 APIs (e.g., https://api.secondbrain.app or https://dev-xyz.us.auth0.com/api/v2/)
VITE_AUTH0_AUDIENCE=

# Backend API Base URL (default for local development: http://localhost:5000/api)
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# BACKEND VARIABLES (server/.env)
# Private server-side secrets. NEVER expose these to the browser or client bundle.
# ------------------------------------------------------------------------------

# Port for Express server (e.g., 5000)
PORT=

# Node Environment: 'development' | 'production'
NODE_ENV=

# MongoDB Connection String (e.g., mongodb://localhost:27017/second-brain or MongoDB Atlas URI)
MONGODB_URI=

# Auth0 Issuer Base URL for backend JWT validation (e.g., https://dev-xyz.us.auth0.com/)
AUTH0_ISSUER_BASE_URL=

# Auth0 API Audience identifier (must match VITE_AUTH0_AUDIENCE)
AUTH0_AUDIENCE=

# Allowed frontend origins for CORS (e.g., http://localhost:5173)
CLIENT_ORIGIN=

# Google Gemini API Key for smart summaries, tag generation, and "Ask My Brain" Q&A
GEMINI_API_KEY=

# Comma-separated list of emails with Admin access (e.g., admin@example.com,lead@secondbrain.app)
ADMIN_EMAILS=
