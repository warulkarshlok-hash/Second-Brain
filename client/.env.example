# ==============================================================================
# SECOND BRAIN - CLIENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Place this file as `client/.env` and supply your actual Auth0 and API values.
# Only variables prefixed with VITE_ are exposed to Vite.
# NEVER put server secrets (MongoDB, Gemini API Key, Auth0 Client Secrets) here!
# ==============================================================================

# Auth0 Domain (from Auth0 Dashboard -> Applications -> Settings -> Domain)
VITE_AUTH0_DOMAIN=

# Auth0 Client ID (from Auth0 Dashboard -> Applications -> Settings -> Client ID)
VITE_AUTH0_CLIENT_ID=

# Auth0 API Audience (from Auth0 Dashboard -> Applications -> APIs -> API Identifier)
VITE_AUTH0_AUDIENCE=

# Backend Express API URL
VITE_API_BASE_URL=
