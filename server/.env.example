# ==============================================================================
# SECOND BRAIN - SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Place this file as `server/.env` and supply your actual secrets.
# NEVER commit your `.env` file to source control.
# ==============================================================================

# Port the Express server listens on (default: 5000)
PORT=

# Node Environment: 'development' | 'production'
NODE_ENV=

# MongoDB URI (local instance or MongoDB Atlas connection string)
MONGODB_URI=

# Auth0 Issuer Base URL (e.g., https://<YOUR_TENANT>.auth0.com/ - include trailing slash)
AUTH0_ISSUER_BASE_URL=

# Auth0 API Audience identifier (must match frontend VITE_AUTH0_AUDIENCE)
AUTH0_AUDIENCE=

# Frontend URL allowed by CORS (e.g., http://localhost:5173)
CLIENT_ORIGIN=

# Google Gemini API Key (obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Comma-separated list of admin email addresses allowed to view and manage Admin Dashboard
ADMIN_EMAILS=
